// =============================================================================
//  Newsroom Platform — Prisma schema
//  Prisma ORM 7 · PostgreSQL 16+
// -----------------------------------------------------------------------------
//  • The connection URL is NOT here — Prisma 7 reads it from apps/api/prisma.config.ts.
//  • Runtime client uses the @prisma/adapter-pg driver adapter (see PrismaService).
//  • Conventions
//      - Models: PascalCase singular. Fields: camelCase. Tables: snake_case plural via @@map.
//      - IDs: UUIDv7 (time-ordered, index-friendly) stored as native `uuid`.
//      - Money: Decimal(12,2) (+ Decimal(12,4) for unit rates) with ISO-4217 `currency` char(3). Never Float.
//      - Soft delete (`deletedAt`) only on user-generated content. Repositories MUST filter it.
//      - Every foreign key column is indexed (Postgres does not do it automatically).
//      - Timestamps are UTC (`timestamptz(3)`).
//  • Things Prisma cannot express are in prisma/sql/*.sql and must be pasted into the
//    first migration (created with `prisma migrate dev --create-only`):
//      - CREATE EXTENSION pg_trgm, unaccent
//      - trigger that maintains articles."searchVector"
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
//  ENUMS
// =============================================================================

// ---- Identity ---------------------------------------------------------------
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OAuthProvider {
  GOOGLE
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---- Content & workflow -----------------------------------------------------
enum ArticleStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum ArticleType {
  NEWS
  FEATURE
  OPINION
  ANALYSIS
  INTERVIEW
  EXPLAINER
  SPONSORED
}

enum ArticleVisibility {
  PUBLIC // anyone
  MEMBERS // logged-in users
  PREMIUM // active subscription
}

enum AssignmentRole {
  REVIEWER
  COPY_EDITOR
  FACT_CHECKER
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  REASSIGNED
}

enum NoteVisibility {
  INTERNAL // editors only
  AUTHOR // visible to the article's author(s)
}

// ---- AI review --------------------------------------------------------------
enum AiReviewStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AiReviewTrigger {
  AUTO_ON_SUBMIT
  MANUAL_AUTHOR
  MANUAL_EDITOR
}

enum AiFindingCategory {
  GRAMMAR
  STYLE
  CLARITY
  STRUCTURE
  HEADLINE
  FACT_CHECK
  LEGAL_RISK
  TOXICITY
  BIAS
  POLICY
  SEO
  DUPLICATE
}

enum AiFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiFindingStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

// ---- Media ------------------------------------------------------------------
enum MediaKind {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
}

enum MediaStatus {
  PENDING // presigned URL issued, upload not confirmed
  PROCESSING // variants being generated
  READY
  FAILED
}

// ---- Engagement -------------------------------------------------------------
enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
  DELETED
}

enum ReactionType {
  LIKE
  INSIGHTFUL
  LOVE
  SAD
  ANGRY
}

enum ReportReason {
  SPAM
  ABUSE
  HATE
  MISINFORMATION
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NewsletterStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

// ---- Advertising ------------------------------------------------------------
enum AdvertiserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AdPage {
  ALL
  HOME
  ARTICLE
  CATEGORY
  SEARCH
}

enum CreativeType {
  IMAGE
  TEXT
  NATIVE
  HTML
}

enum CampaignStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  SCHEDULED // approved, start date in the future
  ACTIVE
  PAUSED
  COMPLETED // end date reached or budget exhausted
  REJECTED
  CANCELED
}

enum PricingModel {
  CPM // price per 1,000 impressions
  CPC // price per click
  FLAT // price per day
}

enum CreativeStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ---- Billing ----------------------------------------------------------------
enum PaymentProvider {
  STRIPE
  SSLCOMMERZ
  MANUAL
}

enum PaymentPurpose {
  SUBSCRIPTION
  AD_CAMPAIGN
  OTHER
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PlanInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// ---- Notifications & CMS ----------------------------------------------------
enum NotificationChannel {
  IN_APP
  EMAIL
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

// =============================================================================
//  M01 / M02 — IDENTITY, ACCESS, PROFILES
// =============================================================================

model User {
  id                     String     @id @default(uuid(7)) @db.Uuid
  email                  String     @unique @db.VarChar(255) /// always stored lower-cased
  emailVerifiedAt        DateTime?  @db.Timestamptz(3)
  passwordHash           String?    @db.VarChar(255) /// argon2id; null for OAuth-only accounts
  name                   String     @db.VarChar(120)
  username               String     @unique @db.VarChar(40)
  avatarUrl              String?    @db.VarChar(500)
  bio                    String?    @db.VarChar(1000)
  locale                 String     @default("en") @db.VarChar(10)
  timezone               String     @default("UTC") @db.VarChar(64)
  status                 UserStatus @default(PENDING_VERIFICATION)
  twoFactorEnabled       Boolean    @default(false)
  twoFactorSecret        String?    @db.VarChar(255) /// AES-256-GCM encrypted (app-level)
  twoFactorRecoveryCodes String[] /// argon2 hashes; each code single-use
  commentBannedUntil     DateTime?  @db.Timestamptz(3)
  lastLoginAt            DateTime?  @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?  @db.Timestamptz(3)

  // identity
  authorProfile      AuthorProfile?
  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  roles              UserRole[]               @relation("UserRoles")
  rolesAssigned      UserRole[]               @relation("RoleAssigner")
  applications       ContributorApplication[] @relation("Applicant")
  applicationsReviewed ContributorApplication[] @relation("ApplicationReviewer")

  // content & workflow
  articles               Article[]             @relation("ArticleAuthor")
  lockedArticles         Article[]             @relation("ArticleLock")
  coAuthoredArticles     ArticleCoAuthor[]
  revisions              ArticleRevision[]
  corrections            ArticleCorrection[]
  workflowTransitions    WorkflowTransition[]
  assignments            EditorialAssignment[] @relation("AssignmentAssignee")
  assignmentsGiven       EditorialAssignment[] @relation("AssignmentAssigner")
  editorialNotes         EditorialNote[]       @relation("NoteAuthor")
  editorialNotesResolved EditorialNote[]       @relation("NoteResolver")
  aiReviewsRequested     AiReview[]
  aiFindingsResolved     AiReviewFinding[]
  mediaAssets            MediaAsset[]

  // engagement
  comments               Comment[]             @relation("CommentAuthor")
  commentsModerated      Comment[]             @relation("CommentModerator")
  commentLikes           CommentLike[]
  commentReports         CommentReport[]       @relation("ReportReporter")
  commentReportsResolved CommentReport[]       @relation("ReportResolver")
  reactions              ArticleReaction[]
  bookmarks              Bookmark[]
  following              AuthorFollow[]        @relation("Follower")
  followers              AuthorFollow[]        @relation("Followed")
  categoryFollows        CategoryFollow[]
  newsletterSubscription NewsletterSubscriber?

  // advertising
  advertiser         Advertiser?
  campaignsCreated   AdCampaign[] @relation("CampaignCreator")
  campaignsReviewed  AdCampaign[] @relation("CampaignReviewer")
  creativesReviewed  AdCreative[] @relation("CreativeReviewer")

  // billing
  subscriptions    Subscription[]
  payments         Payment[]
  refundsRequested Refund[]
  invoices         Invoice[]
  payouts          Payout[]       @relation("PayoutRecipient")
  payoutsApproved  Payout[]       @relation("PayoutApprover")

  // notifications, cms, audit
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  emailLogs               EmailLog[]
  pagesUpdated            Page[]
  settingsUpdated         SiteSetting[]
  auditLogs               AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model AuthorProfile {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @db.Uuid
  penName     String?  @db.VarChar(120)
  designation String?  @db.VarChar(120) /// e.g. "Senior Correspondent"
  longBio     String?  @db.Text
  socialLinks Json? /// { twitter, linkedin, facebook, website }
  isStaff     Boolean  @default(false)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("author_profiles")
}

model OAuthAccount {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @db.VarChar(255)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// One row per issued refresh token. Rotation: on use, revoke + issue child with same familyId.
/// Presenting a revoked token ⇒ revoke the whole family (token theft detection).
model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  familyId      String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(128) /// sha256 of the opaque token
  userAgent     String?   @db.VarChar(500)
  ipAddress     String?   @db.VarChar(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?   @db.VarChar(50) /// ROTATED | LOGOUT | LOGOUT_ALL | REUSE_DETECTED | PASSWORD_RESET | ADMIN
  replacedById  String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  userId    String                @db.Uuid
  type      VerificationTokenType
  tokenHash String                @unique @db.VarChar(128)
  newEmail  String?               @db.VarChar(255) /// only for EMAIL_CHANGE
  expiresAt DateTime              @db.Timestamptz(3)
  usedAt    DateTime?             @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(50) /// e.g. EDITOR — referenced in code via @newsroom/contracts
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) /// system roles cannot be deleted/renamed
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique @db.VarChar(100) /// e.g. article.publish
  module      String  @db.VarChar(50) /// grouping for the admin UI
  description String? @db.VarChar(500)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

/// Reader → Contributor application (USR-05)
model ContributorApplication {
  id           String            @id @default(uuid(7)) @db.Uuid
  userId       String            @db.Uuid
  motivation   String            @db.Text
  sampleLinks  String[]
  status       ApplicationStatus @default(PENDING)
  reviewedById String?           @db.Uuid
  reviewedAt   DateTime?         @db.Timestamptz(3)
  reviewNote   String?           @db.VarChar(1000)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  user       User  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
  @@index([reviewedById])
  @@map("contributor_applications")
}

// =============================================================================
//  M03 — TAXONOMY
// =============================================================================

model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String   @db.VarChar(100)
  slug           String   @unique @db.VarChar(120)
  description    String?  @db.VarChar(1000)
  parentId       String?  @db.Uuid
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  showInNav      Boolean  @default(true)
  color          String?  @db.VarChar(9) /// hex, used for labels
  seoTitle       String?  @db.VarChar(70)
  seoDescription String?  @db.VarChar(170)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  parent      Category?            @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]           @relation("CategoryTree")
  articles    Article[]
  followers   CategoryFollow[]
  adCampaigns AdCampaignCategory[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Tag {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(80)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  articles ArticleTag[]

  @@map("tags")
}

// =============================================================================
//  M04 — MEDIA
// =============================================================================

model MediaAsset {
  id           String      @id @default(uuid(7)) @db.Uuid
  uploaderId   String      @db.Uuid
  kind         MediaKind
  status       MediaStatus @default(PENDING)
  storageKey   String      @unique @db.VarChar(500) /// original object key in the bucket
  originalName String      @db.VarChar(255)
  mimeType     String      @db.VarChar(100)
  sizeBytes    Int
  width        Int?
  height       Int?
  checksum     String?     @db.VarChar(64) /// sha256 hex
  altText      String?     @db.VarChar(300)
  caption      String?     @db.VarChar(500)
  credit       String?     @db.VarChar(200)
  variants     Json? /// { thumb: {key,width,height}, sm: {...}, md: {...}, lg: {...}, xl: {...} }
  errorMessage String?     @db.VarChar(500)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?   @db.Timestamptz(3)

  uploader         User         @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  featuredInArticles Article[]  @relation("ArticleFeaturedImage")
  ogForArticles    Article[]    @relation("ArticleOgImage")
  adCreatives      AdCreative[]

  @@index([uploaderId, createdAt])
  @@index([kind, status, createdAt])
  @@map("media_assets")
}

// =============================================================================
//  M05 / M06 — ARTICLES & EDITORIAL WORKFLOW
// =============================================================================

model Article {
  id                 String            @id @default(uuid(7)) @db.Uuid
  title              String            @db.VarChar(250)
  slug               String            @unique @db.VarChar(280)
  subtitle           String?           @db.VarChar(300)
  excerpt            String?           @db.VarChar(500)
  content            Json /// TipTap / ProseMirror JSON — the source of truth
  contentHtml        String?           @db.Text /// server-rendered + sanitised from `content`
  plainText          String?           @db.Text /// for search, AI, word count
  status             ArticleStatus     @default(DRAFT)
  type               ArticleType       @default(NEWS)
  visibility         ArticleVisibility @default(PUBLIC)
  language           String            @default("en") @db.VarChar(10)
  authorId           String            @db.Uuid
  categoryId         String?           @db.Uuid /// required at submit time (enforced in service)
  featuredImageId    String?           @db.Uuid
  ogImageId          String?           @db.Uuid
  wordCount          Int               @default(0)
  readingTimeMinutes Int               @default(0)
  isFeatured         Boolean           @default(false)
  isBreaking         Boolean           @default(false)
  isEditorsPick      Boolean           @default(false)
  isSponsored        Boolean           @default(false)
  sponsorName        String?           @db.VarChar(150)
  allowComments      Boolean           @default(true)
  needsPostPublishReview Boolean       @default(false) /// set by fast-track publish (WF-11)
  seoTitle           String?           @db.VarChar(70)
  seoDescription     String?           @db.VarChar(170)
  canonicalUrl       String?           @db.VarChar(500)

  /// optimistic locking — every update must send the version it read
  version  Int       @default(1)
  /// soft edit lock (heartbeat-extended)
  lockedById String?   @db.Uuid
  lockedAt   DateTime? @db.Timestamptz(3)

  submittedAt     DateTime? @db.Timestamptz(3)
  approvedAt      DateTime? @db.Timestamptz(3)
  scheduledAt     DateTime? @db.Timestamptz(3)
  publishedAt     DateTime? @db.Timestamptz(3) /// first publish
  lastPublishedAt DateTime? @db.Timestamptz(3) /// latest publish / correction (shown as "Updated")
  archivedAt      DateTime? @db.Timestamptz(3)
  rejectedAt      DateTime? @db.Timestamptz(3)
  rejectionReason String?   @db.VarChar(2000)

  /// denormalised counters (updated by jobs / triggers in services)
  viewCount    Int @default(0)
  commentCount Int @default(0)

  /// maintained by DB trigger (prisma/sql/001_extensions_and_search.sql) — never write from app code
  searchVector Unsupported("tsvector")?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  author        User        @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  featuredImage MediaAsset? @relation("ArticleFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  ogImage       MediaAsset? @relation("ArticleOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  lockedBy      User?       @relation("ArticleLock", fields: [lockedById], references: [id], onDelete: SetNull)

  coAuthors     ArticleCoAuthor[]
  tags          ArticleTag[]
  revisions     ArticleRevision[]
  slugRedirects ArticleSlugRedirect[]
  corrections   ArticleCorrection[]
  transitions   WorkflowTransition[]
  assignments   EditorialAssignment[]
  notes         EditorialNote[]
  aiReviews     AiReview[]
  comments      Comment[]
  reactions     ArticleReaction[]
  bookmarks     Bookmark[]
  dailyStats    ArticleDailyStat[]
  payoutItems   PayoutItem[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([authorId, status, updatedAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@index([isFeatured, publishedAt(sort: Desc)])
  @@index([isBreaking, publishedAt(sort: Desc)])
  @@index([featuredImageId])
  @@index([ogImageId])
  @@index([lockedById])
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "articles_title_trgm_idx")
  @@map("articles")
}

model ArticleCoAuthor {
  articleId String @db.Uuid
  userId    String @db.Uuid
  sortOrder Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([userId])
  @@map("article_co_authors")
}

model ArticleTag {
  articleId String @db.Uuid
  tagId     String @db.Uuid

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

/// Immutable snapshot. Created on submit, resubmit, approve, publish, correction and manual "save version".
model ArticleRevision {
  id            String   @id @default(uuid(7)) @db.Uuid
  articleId     String   @db.Uuid
  versionNumber Int /// 1..n per article
  title         String   @db.VarChar(250)
  subtitle      String?  @db.VarChar(300)
  excerpt       String?  @db.VarChar(500)
  content       Json
  contentHtml   String?  @db.Text
  changeNote    String?  @db.VarChar(500)
  reason        String   @db.VarChar(30) /// SUBMIT | RESUBMIT | APPROVE | PUBLISH | CORRECTION | MANUAL | RESTORE
  createdById   String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  article     Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  aiReviews   AiReview[]
  notes       EditorialNote[]
  transitions WorkflowTransition[]

  @@unique([articleId, versionNumber])
  @@index([createdById])
  @@map("article_revisions")
}

/// Old slug → article. Public site issues 308 redirect (ART-07).
model ArticleSlugRedirect {
  id        String   @id @default(uuid(7)) @db.Uuid
  oldSlug   String   @unique @db.VarChar(280)
  articleId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_slug_redirects")
}

/// Public correction notes on published articles (WF-09)
model ArticleCorrection {
  id          String   @id @default(uuid(7)) @db.Uuid
  articleId   String   @db.Uuid
  note        String   @db.VarChar(1000)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([createdById])
  @@map("article_corrections")
}

/// Append-only audit trail of every status change (WF-10). actorId null = system (scheduler).
model WorkflowTransition {
  id         String         @id @default(uuid(7)) @db.Uuid
  articleId  String         @db.Uuid
  fromStatus ArticleStatus?
  toStatus   ArticleStatus
  action     String         @db.VarChar(40) /// SUBMIT | CLAIM | ASSIGN | REQUEST_CHANGES | APPROVE | REJECT | SCHEDULE | PUBLISH | FASTTRACK | UNPUBLISH | ...
  actorId    String?        @db.Uuid
  revisionId String?        @db.Uuid
  note       String?        @db.VarChar(2000)
  metadata   Json? /// e.g. { acknowledgedCriticalAiFindings: true, scheduledAt }
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  article  Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actor    User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  revision ArticleRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([actorId, createdAt])
  @@index([revisionId])
  @@map("workflow_transitions")
}

model EditorialAssignment {
  id           String           @id @default(uuid(7)) @db.Uuid
  articleId    String           @db.Uuid
  assigneeId   String           @db.Uuid
  assignedById String?          @db.Uuid /// null = self-claimed
  role         AssignmentRole   @default(REVIEWER)
  status       AssignmentStatus @default(ACTIVE)
  dueAt        DateTime?        @db.Timestamptz(3)
  completedAt  DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  assignee   User    @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy User?   @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([articleId, status])
  @@index([assigneeId, status, dueAt])
  @@index([assignedById])
  @@map("editorial_assignments")
}

/// Review comments. `anchor` ties a note to a text range: { from, to, quote } (ProseMirror positions + quoted text fallback)
model EditorialNote {
  id           String         @id @default(uuid(7)) @db.Uuid
  articleId    String         @db.Uuid
  revisionId   String?        @db.Uuid
  authorId     String         @db.Uuid
  parentId     String?        @db.Uuid
  body         String         @db.Text
  anchor       Json?
  visibility   NoteVisibility @default(AUTHOR)
  isResolved   Boolean        @default(false)
  resolvedById String?        @db.Uuid
  resolvedAt   DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?      @db.Timestamptz(3)

  article    Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision   ArticleRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  author     User             @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  resolvedBy User?            @relation("NoteResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  parent     EditorialNote?   @relation("NoteThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    EditorialNote[]  @relation("NoteThread")

  @@index([articleId, createdAt])
  @@index([revisionId])
  @@index([authorId])
  @@index([parentId])
  @@index([resolvedById])
  @@map("editorial_notes")
}

// =============================================================================
//  M07 — AI-ASSISTED REVIEW
// =============================================================================

model AiReview {
  id             String          @id @default(uuid(7)) @db.Uuid
  articleId      String          @db.Uuid
  revisionId     String?         @db.Uuid
  trigger        AiReviewTrigger
  status         AiReviewStatus  @default(QUEUED)
  provider       String          @db.VarChar(30) /// anthropic | openai
  model          String          @db.VarChar(80)
  promptVersion  String          @db.VarChar(30) /// e.g. review.v3 — prompts are versioned in code
  overallScore   Int? /// 0..100
  readability    Float? /// Flesch reading ease (computed locally, not by the model)
  summary        String?         @db.Text
  suggestions    Json? /// { headlines: string[], seoTitle, metaDescription, excerpt, tags: string[] }
  duplicateMatches Json? /// [{ articleId, title, similarity }]
  inputTokens    Int?
  outputTokens   Int?
  costUsd        Decimal?        @db.Decimal(10, 6)
  latencyMs      Int?
  attempts       Int             @default(0)
  errorMessage   String?         @db.VarChar(2000)
  requestedById  String?         @db.Uuid /// null for AUTO_ON_SUBMIT
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  startedAt      DateTime?       @db.Timestamptz(3)
  completedAt    DateTime?       @db.Timestamptz(3)

  article     Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision    ArticleRevision?  @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  requestedBy User?             @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  findings    AiReviewFinding[]

  @@index([articleId, createdAt(sort: Desc)])
  @@index([revisionId])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
  @@map("ai_reviews")
}

model AiReviewFinding {
  id           String            @id @default(uuid(7)) @db.Uuid
  reviewId     String            @db.Uuid
  category     AiFindingCategory
  severity     AiFindingSeverity
  message      String            @db.Text
  suggestion   String?           @db.Text
  excerpt      String?           @db.Text /// quoted text the finding refers to
  startOffset  Int? /// offsets into Article.plainText at review time
  endOffset    Int?
  status       AiFindingStatus   @default(OPEN)
  resolvedById String?           @db.Uuid
  resolvedAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  review     AiReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reviewId, severity])
  @@index([resolvedById])
  @@map("ai_review_findings")
}

// =============================================================================
//  M09 — ENGAGEMENT
// =============================================================================

model Comment {
  id             String        @id @default(uuid(7)) @db.Uuid
  articleId      String        @db.Uuid
  userId         String        @db.Uuid
  parentId       String?       @db.Uuid /// 1 level of replies (enforced in service)
  body           String        @db.VarChar(5000)
  status         CommentStatus @default(PENDING)
  likeCount      Int           @default(0)
  reportCount    Int           @default(0)
  ipHash         String?       @db.VarChar(64) /// sha256(ip + salt) for abuse handling, never raw IP
  editedAt       DateTime?     @db.Timestamptz(3)
  moderatedById  String?       @db.Uuid
  moderatedAt    DateTime?     @db.Timestamptz(3)
  moderationNote String?       @db.VarChar(500)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)

  article     Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User            @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  moderatedBy User?           @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  parent      Comment?        @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]       @relation("CommentThread")
  likes       CommentLike[]
  reports     CommentReport[]

  @@index([articleId, status, createdAt])
  @@index([userId, createdAt])
  @@index([parentId])
  @@index([status, createdAt])
  @@index([moderatedById])
  @@map("comments")
}

model CommentLike {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model CommentReport {
  id           String       @id @default(uuid(7)) @db.Uuid
  commentId    String       @db.Uuid
  reporterId   String       @db.Uuid
  reason       ReportReason
  details      String?      @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  resolvedById String?      @db.Uuid
  resolvedAt   DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([commentId, reporterId])
  @@index([reporterId])
  @@index([status, createdAt])
  @@index([resolvedById])
  @@map("comment_reports")
}

/// One reaction per user per article (changing reaction = update `type`)
model ArticleReaction {
  userId    String       @db.Uuid
  articleId String       @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId, type])
  @@map("article_reactions")
}

model Bookmark {
  userId    String   @db.Uuid
  articleId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bookmarks")
}

model AuthorFollow {
  followerId String   @db.Uuid
  authorId   String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  author   User @relation("Followed", fields: [authorId], references: [id], onDelete: Cascade)

  @@id([followerId, authorId])
  @@index([authorId])
  @@map("author_follows")
}

model CategoryFollow {
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
  @@map("category_follows")
}

model NewsletterSubscriber {
  id               String           @id @default(uuid(7)) @db.Uuid
  email            String           @unique @db.VarChar(255)
  userId           String?          @unique @db.Uuid
  status           NewsletterStatus @default(PENDING)
  confirmTokenHash String?          @unique @db.VarChar(128)
  unsubscribeToken String           @unique @db.VarChar(64) /// opaque, used in every email footer
  preferences      Json? /// { categories: string[], frequency: "daily" | "weekly" }
  source           String?          @db.VarChar(50) /// footer | article | signup | import
  confirmedAt      DateTime?        @db.Timestamptz(3)
  unsubscribedAt   DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("newsletter_subscribers")
}

// =============================================================================
//  M17 — ANALYTICS (aggregates; raw hits live in Redis and are flushed by jobs)
// =============================================================================

model ArticleDailyStat {
  articleId      String   @db.Uuid
  date           DateTime @db.Date /// site-timezone calendar day
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, date])
  @@index([date])
  @@map("article_daily_stats")
}

// =============================================================================
//  M11 — ADVERTISING
// =============================================================================

model Advertiser {
  id             String           @id @default(uuid(7)) @db.Uuid
  ownerId        String           @unique @db.Uuid
  companyName    String           @db.VarChar(200)
  contactName    String?          @db.VarChar(120)
  contactEmail   String           @db.VarChar(255)
  phone          String?          @db.VarChar(40)
  website        String?          @db.VarChar(300)
  billingAddress Json? /// { line1, line2, city, state, postalCode, country }
  taxId          String?          @db.VarChar(60)
  status         AdvertiserStatus @default(PENDING)
  notes          String?          @db.VarChar(2000) /// internal (AD_MANAGER only)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  campaigns AdCampaign[]

  @@index([status])
  @@map("advertisers")
}

model AdPlacement {
  id             String         @id @default(uuid(7)) @db.Uuid
  key            String         @unique @db.VarChar(60) /// e.g. home_leaderboard — referenced by <AdSlot placement="..."/>
  name           String         @db.VarChar(120)
  description    String?        @db.VarChar(500)
  page           AdPage         @default(ALL)
  width          Int?
  height         Int?
  allowedTypes   CreativeType[]
  maxRotating    Int            @default(3) /// max distinct campaigns rotating in this slot
  cpmRate        Decimal?       @db.Decimal(12, 4)
  cpcRate        Decimal?       @db.Decimal(12, 4)
  flatDailyRate  Decimal?       @db.Decimal(12, 2)
  currency       String         @default("USD") @db.Char(3)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  campaigns  AdCampaignPlacement[]
  dailyStats AdDailyStat[]

  @@map("ad_placements")
}

model AdCampaign {
  id                 String         @id @default(uuid(7)) @db.Uuid
  advertiserId       String?        @db.Uuid /// null for house ads
  name               String         @db.VarChar(200)
  status             CampaignStatus @default(DRAFT)
  pricingModel       PricingModel
  rate               Decimal        @db.Decimal(12, 4) /// snapshot of rate at booking: per 1k impressions | per click | per day
  budgetTotal        Decimal        @db.Decimal(12, 2)
  budgetDaily        Decimal?       @db.Decimal(12, 2)
  spentAmount        Decimal        @default(0) @db.Decimal(12, 4)
  currency           String         @default("USD") @db.Char(3)
  startAt            DateTime       @db.Timestamptz(3)
  endAt              DateTime       @db.Timestamptz(3)
  priority           Int            @default(10) /// higher wins; house ads use 0
  isHouse            Boolean        @default(false)
  targeting          Json? /// { devices: ("desktop"|"mobile"|"tablet")[], languages: string[], countries: string[] }
  frequencyCapPerDay Int? /// max impressions per visitor per day
  rejectionReason    String?        @db.VarChar(1000)
  reviewedById       String?        @db.Uuid
  reviewedAt         DateTime?      @db.Timestamptz(3)
  createdById        String         @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?      @db.Timestamptz(3)

  advertiser Advertiser?           @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  reviewedBy User?                 @relation("CampaignReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy  User                  @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  placements AdCampaignPlacement[]
  categories AdCampaignCategory[]
  creatives  AdCreative[]
  dailyStats AdDailyStat[]
  payments   Payment[]

  @@index([advertiserId, status])
  @@index([status, startAt, endAt])
  @@index([reviewedById])
  @@index([createdById])
  @@map("ad_campaigns")
}

model AdCampaignPlacement {
  campaignId  String @db.Uuid
  placementId String @db.Uuid

  campaign  AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement AdPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@id([campaignId, placementId])
  @@index([placementId])
  @@map("ad_campaign_placements")
}

/// Category targeting. No rows = run of site.
model AdCampaignCategory {
  campaignId String @db.Uuid
  categoryId String @db.Uuid

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([campaignId, categoryId])
  @@index([categoryId])
  @@map("ad_campaign_categories")
}

model AdCreative {
  id              String         @id @default(uuid(7)) @db.Uuid
  campaignId      String         @db.Uuid
  type            CreativeType
  name            String         @db.VarChar(150)
  headline        String?        @db.VarChar(120)
  body            String?        @db.VarChar(300)
  imageId         String?        @db.Uuid
  html            String?        @db.Text /// HTML type only; always rendered in a sandboxed iframe
  targetUrl       String         @db.VarChar(1000)
  altText         String?        @db.VarChar(300)
  weight          Int            @default(1)
  status          CreativeStatus @default(PENDING_REVIEW)
  rejectionReason String?        @db.VarChar(1000)
  reviewedById    String?        @db.Uuid
  reviewedAt      DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?      @db.Timestamptz(3)

  campaign   AdCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  image      MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  reviewedBy User?         @relation("CreativeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  dailyStats AdDailyStat[]

  @@index([campaignId, status])
  @@index([imageId])
  @@index([reviewedById])
  @@map("ad_creatives")
}

/// Flushed from Redis counters every few minutes (upsert + increment).
model AdDailyStat {
  creativeId  String   @db.Uuid
  placementId String   @db.Uuid
  date        DateTime @db.Date
  campaignId  String   @db.Uuid
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 4)

  creative  AdCreative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placement AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  campaign  AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([creativeId, placementId, date])
  @@index([campaignId, date])
  @@index([placementId, date])
  @@map("ad_daily_stats")
}

// =============================================================================
//  M12 — PAYMENTS, SUBSCRIPTIONS, INVOICES
// =============================================================================

model Plan {
  id               String       @id @default(uuid(7)) @db.Uuid
  key              String       @unique @db.VarChar(60) /// e.g. premium_monthly
  name             String       @db.VarChar(120)
  description      String?      @db.VarChar(1000)
  price            Decimal      @db.Decimal(12, 2)
  currency         String       @default("USD") @db.Char(3)
  interval         PlanInterval
  intervalCount    Int          @default(1)
  trialDays        Int          @default(0)
  features         Json? /// string[] shown on pricing page
  providerPriceIds Json? /// { STRIPE: "price_..." }
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  userId                 String             @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus @default(INCOMPLETE)
  provider               PaymentProvider
  providerSubscriptionId String?            @db.VarChar(255)
  providerCustomerId     String?            @db.VarChar(255)
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  trialEndsAt            DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?          @db.Timestamptz(3)
  endedAt                DateTime?          @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId, status])
  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Payment {
  id                 String          @id @default(uuid(7)) @db.Uuid
  userId             String          @db.Uuid
  purpose            PaymentPurpose
  provider           PaymentProvider
  status             PaymentStatus   @default(PENDING)
  amount             Decimal         @db.Decimal(12, 2)
  amountRefunded     Decimal         @default(0) @db.Decimal(12, 2)
  currency           String          @db.Char(3)
  idempotencyKey     String          @unique @db.VarChar(100)
  providerPaymentId  String?         @db.VarChar(255) /// charge / payment intent / tran_id
  providerCheckoutId String?         @db.VarChar(255) /// checkout session / gateway session
  subscriptionId     String?         @db.Uuid
  campaignId         String?         @db.Uuid
  invoiceId          String?         @db.Uuid
  failureReason      String?         @db.VarChar(1000)
  metadata           Json?
  paidAt             DateTime?       @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  campaign     AdCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refunds      Refund[]

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([subscriptionId])
  @@index([campaignId])
  @@index([invoiceId])
  @@index([providerCheckoutId])
  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @db.Uuid
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?      @db.VarChar(500)
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique @db.VarChar(255)
  requestedById    String       @db.Uuid
  processedAt      DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User    @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([requestedById])
  @@map("refunds")
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  number         String        @unique @db.VarChar(30) /// INV-2026-000123, sequential (DB sequence)
  userId         String        @db.Uuid
  status         InvoiceStatus @default(DRAFT)
  currency       String        @db.Char(3)
  subtotal       Decimal       @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2) /// percent
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  billingDetails Json? /// snapshot: name, company, address, taxId at time of issue
  pdfKey         String?       @db.VarChar(500)
  issuedAt       DateTime?     @db.Timestamptz(3)
  dueAt          DateTime?     @db.Timestamptz(3)
  paidAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments Payment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  invoiceId   String  @db.Uuid
  description String  @db.VarChar(500)
  quantity    Int     @default(1)
  unitAmount  Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// Raw gateway webhook events — idempotency + replay/debug.
model WebhookEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  provider    PaymentProvider
  eventId     String          @db.VarChar(255)
  type        String          @db.VarChar(120)
  payload     Json
  status      WebhookStatus   @default(RECEIVED)
  attempts    Int             @default(0)
  error       String?         @db.VarChar(2000)
  receivedAt  DateTime        @default(now()) @db.Timestamptz(3)
  processedAt DateTime?       @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// =============================================================================
//  M13 — CONTRIBUTOR PAYOUTS  [CONFIRM scope]
// =============================================================================

model Payout {
  id           String       @id @default(uuid(7)) @db.Uuid
  userId       String       @db.Uuid
  amount       Decimal      @db.Decimal(12, 2)
  currency     String       @db.Char(3)
  status       PayoutStatus @default(PENDING)
  periodStart  DateTime     @db.Date
  periodEnd    DateTime     @db.Date
  method       String?      @db.VarChar(60) /// bank | bkash | paypal | ...
  reference    String?      @db.VarChar(200) /// external transfer reference
  notes        String?      @db.VarChar(1000)
  approvedById String?      @db.Uuid
  approvedAt   DateTime?    @db.Timestamptz(3)
  paidAt       DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  user       User         @relation("PayoutRecipient", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy User?        @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items      PayoutItem[]

  @@unique([userId, periodStart, periodEnd])
  @@index([status])
  @@index([approvedById])
  @@map("payouts")
}

model PayoutItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  payoutId    String  @db.Uuid
  articleId   String? @db.Uuid
  description String  @db.VarChar(500)
  amount      Decimal @db.Decimal(12, 2)

  payout  Payout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([payoutId])
  @@index([articleId])
  @@map("payout_items")
}

// =============================================================================
//  M14 — NOTIFICATIONS & EMAIL
// =============================================================================

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  type      String    @db.VarChar(80) /// e.g. article.changes_requested — catalogue in @newsroom/contracts
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(1000)
  link      String?   @db.VarChar(500) /// relative web path
  data      Json?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId  String              @db.Uuid
  type    String              @db.VarChar(80)
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

model EmailLog {
  id                String      @id @default(uuid(7)) @db.Uuid
  userId            String?     @db.Uuid
  toEmail           String      @db.VarChar(255)
  template          String      @db.VarChar(80)
  subject           String      @db.VarChar(300)
  status            EmailStatus @default(QUEUED)
  providerMessageId String?     @db.VarChar(255)
  error             String?     @db.VarChar(2000)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  sentAt            DateTime?   @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([toEmail])
  @@map("email_logs")
}

// =============================================================================
//  M16 — CMS PAGES, MENUS, SETTINGS
// =============================================================================

model Page {
  id             String     @id @default(uuid(7)) @db.Uuid
  title          String     @db.VarChar(200)
  slug           String     @unique @db.VarChar(200)
  content        Json
  contentHtml    String?    @db.Text
  status         PageStatus @default(DRAFT)
  seoTitle       String?    @db.VarChar(70)
  seoDescription String?    @db.VarChar(170)
  updatedById    String?    @db.Uuid
  publishedAt    DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("pages")
}

model Menu {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(40) /// header | footer | footer_legal
  items     Json /// [{ label, href, children?: [...] }]
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("menus")
}

/// Key/value settings. `isPublic` settings are served to the web app without auth. Secrets NEVER live here.
model SiteSetting {
  key         String   @id @db.VarChar(100) /// e.g. workflow.requireChiefApproval
  value       Json
  group       String   @db.VarChar(50) /// general | seo | workflow | comments | paywall | ai | ads | billing | email
  isPublic    Boolean  @default(false)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
  @@index([updatedById])
  @@map("site_settings")
}

// =============================================================================
//  M18 — AUDIT LOG (append-only; no updates or deletes from app code)
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(80) /// e.g. article.publish, user.role.assign, payment.refund
  entityType String   @db.VarChar(50)
  entityId   String?  @db.VarChar(64)
  before     Json?
  after      Json?
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(500)
  requestId  String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
