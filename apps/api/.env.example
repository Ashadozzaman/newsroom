# Copy to apps/api/.env (and apps/api/.env.test for e2e). Every variable is validated at boot
# by src/config/env.schema.ts — add new ones in BOTH places.

# ---- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
TRUST_PROXY=true
# Public web origin (single origin: web + /api/v1 behind the reverse proxy)
APP_URL=http://localhost:3000
# Where the API calls Next.js for on-demand revalidation
WEB_INTERNAL_URL=http://localhost:3000
SWAGGER_ENABLED=true

# ---- Database & cache --------------------------------------------------------
DATABASE_URL=postgresql://newsroom:newsroom@localhost:5432/newsroom?schema=public
REDIS_URL=redis://localhost:6379/0

# ---- Auth & crypto -------------------------------------------------------------
# Generate secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false
# 32 bytes, base64 — AES-256-GCM for 2FA secrets (openssl rand -base64 32)
ENCRYPTION_KEY=
# HMAC secrets for preview links and ad tracking tokens
PREVIEW_SIGNING_SECRET=
ADS_SIGNING_SECRET=
# Shared with apps/web (REVALIDATE_SECRET)
REVALIDATE_SECRET=

# ---- OAuth -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ---- Object storage (S3-compatible) ------------------------------------------------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=newsroom-media
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/newsroom-media
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOCUMENT_MB=20

# ---- Email -------------------------------------------------------------------------
MAIL_FROM="Newsroom <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- AI review -----------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_REVIEW=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Optional JSON override of USD per 1M tokens, e.g. {"claude-sonnet-5-5":{"input":3,"output":15}}
AI_PRICING_OVERRIDES=

# ---- Payments -----------------------------------------------------------------------
# Comma-separated list of enabled adapters: STRIPE,SSLCOMMERZ
PAYMENT_PROVIDERS=STRIPE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ---- Observability -------------------------------------------------------------------
SENTRY_DSN=

# ---- Seed ------------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!12345
SEED_DEMO_DATA=true
