# Copy to apps/web/.env.local
# Server-only: how Next.js (RSC, route handlers, proxy.ts) reaches the API directly
API_INTERNAL_URL=http://localhost:4000
# Shared with apps/api REVALIDATE_SECRET
REVALIDATE_SECRET=

# Exposed to the browser (NEXT_PUBLIC_*)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Newsroom
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8333/newsroom-media
NEXT_PUBLIC_SENTRY_DSN=

# Server-side Sentry
SENTRY_DSN=
